{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build",
        "dev": "vite",
        "format": "prettier --write resources/js resources/css vite.config.ts tailwind.config.ts eslint.config.js tsconfig.json",
        "format:check": "prettier --check resources/js resources/css vite.config.ts tailwind.config.ts eslint.config.js tsconfig.json",
        "lint": "eslint resources/js --max-warnings=0",
        "typecheck": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.4.12",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.12.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.31",
        "prettier": "^3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^6.0.11",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1",
        "vue": "^3.4.0",
        "vue-tsc": "^2.0.24"
    },
    "dependencies": {
        "@lucide/vue": "^1.47.0",
        "@zxing/browser": "^0.2.1",
        "dexie": "^4.4.6"
    }
}
